{
  // Cloudflare Worker config for the ReefTrack AI proxy.
  // Pure code Worker (no static assets) — the app itself is served by
  // GitHub Pages, so this Worker only needs to run _worker.js for /claude.
  "name": "reeftrack-kasa",
  "main": "_worker.js",
  "compatibility_date": "2024-11-01",
  // Cron watchdog: run every minute to keep configured outlets (e.g. skimmer)
  // OFF after a power outage. Needs KASA_EMAIL / KASA_PASSWORD secrets set.
  "triggers": { "crons": ["* * * * *"] }
}
